{
  "manifest_version": 3,
  "name": "X Daily Rings · 每日输出环",
  "version": "0.3.0",
  "description": "发帖、回复、引用每日圆环，已加载关注名单扫描与重置。",
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "model.js",
      "state.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "x-daily-rings@hskelp9527-pixel.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "model.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
